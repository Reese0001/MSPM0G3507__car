# Offline command-line build for MSPM0G3507_LineFollowing_Car.
#
# CCS Theia has no headless build command, and Debug/*.mk is regenerated by the
# IDE, so this makefile mirrors the CCS "Debug" configuration (same compiler,
# flags, generated linker command files and source exclusions) to let the build
# be verified without opening the GUI. CLI output goes to ../build/cli/,
# which .cproject excludes and .gitignore ignores.
#
#   gmake -C MSPM0G3507_LineFollowing_Car -j4 all      # .out + .map
#   gmake -C MSPM0G3507_LineFollowing_Car images       # + .hex and TI-TXT
#   gmake -C MSPM0G3507_LineFollowing_Car rebuild      # clean + all + images
#   gmake -C MSPM0G3507_LineFollowing_Car clean
#
# The CCS GUI build remains authoritative for what gets flashed over SWD.

# Recipes use cmd.exe syntax so the build behaves the same whether gmake is
# started from PowerShell or from a Git Bash shell (which would otherwise be
# picked up as SHELL).
SHELL       := cmd.exe
.SHELLFLAGS := /C

SDK_DIR       ?= C:/ti/mspm0_sdk_2_10_00_04
CCS_DIR       ?= D:/DevTools/ti/ccs2050/ccs
SYSCONFIG_CLI ?= C:/TI/sysconfig_1.26.2/sysconfig_cli.bat
TOOLCHAIN_DIR ?= $(CCS_DIR)/tools/compiler/ti-cgt-armllvm_4.0.4.LTS/bin
TIARMCLANG    ?= $(TOOLCHAIN_DIR)/tiarmclang.exe
TIARMHEX      ?= $(TOOLCHAIN_DIR)/tiarmhex.exe
TIARMOBJCOPY  ?= $(TOOLCHAIN_DIR)/tiarmobjcopy.exe

NAME       := MSPM0G3507_LineFollowing_Car
BUILD_DIR  := ../build/cli/MSPM0G3507_LineFollowing_Car
OBJ_DIR    := $(BUILD_DIR)/obj
FIRMWARE_DIR := ../dist/firmware

TARGET  := $(BUILD_DIR)/$(NAME).out
MAP     := $(BUILD_DIR)/$(NAME).map
HEX     := $(FIRMWARE_DIR)/$(NAME).hex
TITXT   := $(FIRMWARE_DIR)/$(NAME).txt

GEN_CONFIG  := $(BUILD_DIR)/ti_msp_dl_config.c
GEN_LINKER  := $(BUILD_DIR)/device_linker.cmd
GEN_GENLIBS := $(BUILD_DIR)/device.cmd.genlibs
GEN_OPT     := $(BUILD_DIR)/device.opt

STARTUP_SRC := $(SDK_DIR)/source/ti/devices/msp/m0p/startup_system_files/ticlang/startup_mspm0g350x_ticlang.c

# Source set mirrors the .cproject sourceEntries exclusion list. Firmware has
# one active native runtime entry: empty.c -> app/tasks/app_tasks.c. Older application
# schedulers and optional hardware modules stay in the tree for reference/tests
# but are not linked into the car image.
SOURCES := \
    empty.c \
    app/boot/app_boot.c \
    modules/diagnostics/boot_trace.c \
    modules/line_tracking/recovery/line_recovery.c \
    app/safety/safety_supervisor.c \
    modules/display/dashboard.c \
    modules/display/runtime_log.c \
    app/mailbox/app_mailbox.c \
    app/run/run_controller.c \
    app/sensor/sensor_runtime.c \
    app/control/control_runtime.c \
    app/line/line_motion.c \
    app/log/runtime_observer.c \
    app/tasks/app_tasks.c \
    app/safety/safety_runtime.c \
    bsp/bsp_i2c.c \
    modules/line_tracking/scanner/line_mux.c \
    modules/display/i2c/oled_i2c.c \
    modules/time/delay.c \
    modules/time/timer.c \
    modules/buzzer/buzzer.c \
    modules/display/ssd1306/ssd1306.c \
    modules/key/key.c \
    modules/led/led.c \
    modules/line_tracking/controller/line_lookup_control.c \
    modules/line_tracking/decoder/line_position.c \
    modules/line_tracking/scanner/line_scanner.c \
    modules/motor/configuration/motor_configuration.c \
    modules/motor/protocol/motor_protocol.c \
    modules/motor/uart/motor_uart.c \
    modules/motor/adapter/motor_adapter.c \
    modules/motor/safety/motor_safety.c \
    modules/mpu6050/mpu6050.c

# Object names are flattened so no nested directories have to be created.
mangle = $(OBJ_DIR)/$(subst /,_,$(basename $(1))).o

OBJECTS := $(foreach s,$(SOURCES),$(call mangle,$(s))) \
    $(OBJ_DIR)/ti_msp_dl_config.o \
    $(OBJ_DIR)/startup_mspm0g350x_ticlang.o

CPPFLAGS := \
    -D__MSPM0G3507__ \
    -D__USE_SYSCONFIG__ \
    -I. \
    -I$(BUILD_DIR) \
    -Iapp \
    -Iapp/boot \
    -Iapp/mailbox \
    -Iapp/run \
    -Iapp/sensor \
    -Iapp/control \
    -Iapp/line \
    -Iapp/log \
    -Iapp/safety \
    -Iapp/tasks \
    -Iconfig \
    -Ishared \
    -Ibsp \
    -Imodules \
    -Imodules/diagnostics \
    -Imodules/buzzer \
    -Imodules/key \
    -Imodules/led \
    -Imodules/line_tracking \
    -Imodules/line_tracking/controller \
    -Imodules/line_tracking/decoder \
    -Imodules/line_tracking/recovery \
    -Imodules/line_tracking/scanner \
    -Imodules/motor \
    -Imodules/motor/adapter \
    -Imodules/motor/configuration \
    -Imodules/motor/protocol \
    -Imodules/motor/safety \
    -Imodules/motor/uart \
    -Imodules/mpu6050 \
    -Imodules/display \
    -Imodules/display/i2c \
    -Imodules/display/ssd1306 \
    -Imodules/time \
    -I$(SDK_DIR)/source \
    -I$(SDK_DIR)/source/third_party/CMSIS/Core/Include

CFLAGS := -march=thumbv6m -mcpu=cortex-m0plus -mfloat-abi=soft -mlittle-endian \
    -mthumb -O2 -gdwarf-3 -Wall -MMD -MP

LDFLAGS := -march=thumbv6m -mcpu=cortex-m0plus -mfloat-abi=soft -mlittle-endian \
    -mthumb -O2 -gdwarf-3 -Wall \
    -Wl,-m"$(MAP)" \
    -Wl,-i"$(SDK_DIR)/source" \
    -Wl,-i"." \
    -Wl,-i"$(BUILD_DIR)" \
    -Wl,-i"$(TOOLCHAIN_DIR)/../lib" \
    -Wl,--diag_wrap=off -Wl,--display_error_number -Wl,--warn_sections \
    -Wl,--xml_link_info="$(BUILD_DIR)/$(NAME)_linkInfo.xml" \
    -Wl,--rom_model

LDLIBS := -Wl,-l"$(GEN_LINKER)" -Wl,-ldevice.cmd.genlibs -Wl,-llibc.a

.PHONY: all images rebuild syscfg clean

all: $(TARGET)

images: $(HEX) $(TITXT)

rebuild: clean all images

syscfg: $(GEN_CONFIG)

$(BUILD_DIR):
	@if not exist "$(subst /,\,$(BUILD_DIR))" mkdir "$(subst /,\,$(BUILD_DIR))"

$(OBJ_DIR): | $(BUILD_DIR)
	@if not exist "$(subst /,\,$(OBJ_DIR))" mkdir "$(subst /,\,$(OBJ_DIR))"

$(FIRMWARE_DIR):
	@if not exist "$(subst /,\,$(FIRMWARE_DIR))" mkdir "$(subst /,\,$(FIRMWARE_DIR))"

# SysConfig emits ti_msp_dl_config.[ch], device.opt, device_linker.cmd and
# device.cmd.genlibs in one pass; the rest just follow the .c file.
$(GEN_CONFIG): empty.syscfg | $(BUILD_DIR)
	"$(SYSCONFIG_CLI)" -s "$(SDK_DIR)/.metadata/product.json" --script "empty.syscfg" -o "$(BUILD_DIR)" --compiler ticlang

$(GEN_LINKER) $(GEN_GENLIBS) $(GEN_OPT): $(GEN_CONFIG)
	@echo generated with $<

define COMPILE_RULE
$(call mangle,$(1)): $(1) $$(GEN_CONFIG) | $$(OBJ_DIR)
	$$(TIARMCLANG) -c $$(CPPFLAGS) $$(CFLAGS) -o $$@ $$<
endef
$(foreach s,$(SOURCES),$(eval $(call COMPILE_RULE,$(s))))

$(OBJ_DIR)/ti_msp_dl_config.o: $(GEN_CONFIG) | $(OBJ_DIR)
	$(TIARMCLANG) -c $(CPPFLAGS) $(CFLAGS) -o $@ $<

$(OBJ_DIR)/startup_mspm0g350x_ticlang.o: $(STARTUP_SRC) $(GEN_CONFIG) | $(OBJ_DIR)
	$(TIARMCLANG) -c $(CPPFLAGS) $(CFLAGS) -o $@ $<

$(TARGET): $(OBJECTS) $(GEN_LINKER) $(GEN_GENLIBS)
	$(TIARMCLANG) $(LDFLAGS) -o $@ $(OBJECTS) $(LDLIBS)

$(HEX): $(TARGET) | $(FIRMWARE_DIR)
	"$(TIARMOBJCOPY)" -O ihex "$<" "$@"

$(TITXT): $(TARGET) | $(FIRMWARE_DIR)
	"$(TIARMHEX)" --ti_txt "$<" -o "$@"

clean:
	@if exist "$(subst /,\,$(OBJ_DIR))" rmdir /S /Q "$(subst /,\,$(OBJ_DIR))"
	@if exist "$(subst /,\,$(TARGET))" del /F /Q "$(subst /,\,$(TARGET))"
	@if exist "$(subst /,\,$(MAP))" del /F /Q "$(subst /,\,$(MAP))"
	@if exist "$(subst /,\,$(GEN_CONFIG))" del /F /Q "$(subst /,\,$(GEN_CONFIG))"

-include $(OBJECTS:.o=.d)
